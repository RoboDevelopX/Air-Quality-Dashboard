# Copy to .env and adjust. Every variable is optional; the defaults below are used when unset.

# City shown when the app opens, and the AQI standard used for the headline (us_epa | in_naqi).
AQD_DEFAULT_CITY=New Delhi
AQD_AQI_STANDARD=us_epa

# SQLite response cache and its time-to-live per kind of request, in seconds.
AQD_CACHE_PATH=.cache/aqd.sqlite3
AQD_CACHE_TTL_FORECAST=3600
AQD_CACHE_TTL_HISTORY=21600
AQD_CACHE_TTL_GEOCODE=2592000

# HTTP timeout for provider calls, in seconds.
AQD_HTTP_TIMEOUT=10

# Logging: level (DEBUG, INFO, WARNING, ERROR) and format (json | text).
AQD_LOG_LEVEL=INFO
AQD_LOG_FORMAT=json

# Directory holding the trained model artifact.
AQD_MODEL_DIR=models

# Optional second data source. Leave empty to run on Open-Meteo only.
OPENAQ_API_KEY=
